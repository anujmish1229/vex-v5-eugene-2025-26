{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n\n# ------------------------------------------\n#\n#   Project:\n#   Author:\n#   Created:\n#   Configuration:\n#\n# ------------------------------------------\n\n\n# Library imports\nfrom vex import *\n\n\n# Begin project code\n\n\ndef print_variable():\n   while True:\n       s = dis.object_distance(INCHES)\n       d = drivetrain_inertial.heading(DEGREES)\n       print(str(s) + \"in \" + str(math.floor(d)) + \" *\")\n       wait(100, MSEC) # Small delay to allow other code to run\n\n\n\n\ndef pre_autonomous():\n   # actions to do when the program starts\n   brain.screen.clear_screen()\n   brain.screen.print(\"pre auton code\")\n   intake.set_max_torque(100, PERCENT)\n   intake.set_velocity(100, PERCENT)\n   output.set_max_torque(100, PERCENT)\n   output.set_velocity(100, PERCENT)\n   drivetrain.set_heading(90, DEGREES)\n   drivetrain.set_drive_velocity(35, PERCENT)\n   drivetrain.set_turn_velocity(25, PERCENT)\n   print_thread = Thread(print_variable)\n\n\ndef autonomous():\n   intake.spin(FORWARD)\n   drivetrain.drive_for(FORWARD, 5, INCHES, wait=True)\n   drivetrain.turn_for(LEFT, 90, DEGREES)\n   drivetrain.drive(REVERSE)\n   wait(1, SECONDS)\n   intake.spin(FORWARD)\n   drivetrain.stop()\n   drivetrain.set_heading(0, DEGREES)\n   drivetrain.drive(FORWARD)\n   while dis.object_distance(INCHES) < 28:\n       pass\n   drivetrain.stop()\n   intake.spin(FORWARD)\n   wait(1.5, SECONDS)\n   intake.spin(FORWARD)\n   output.spin(REVERSE)\n   wait(0.6, SECONDS)\n   output.stop()\n   intake.spin(REVERSE)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   drivetrain.drive_for(FORWARD, 15, INCHES, wait=True)\n   intake.spin(FORWARD)\n   output.spin(REVERSE)\n   wait(0.2, SECONDS)\n   output.stop()\n   intake.spin(REVERSE)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   drivetrain.turn_for(LEFT, 90, DEGREES)\n   drivetrain.drive_for(FORWARD, 32, INCHES, wait=True)\n   drivetrain.stop()\n   intake.spin(FORWARD)\n   wait(1, SECONDS)\n   intake.spin(REVERSE)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   wait(1, SECONDS)\n   intake.spin(REVERSE)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   drivetrain.drive_for(FORWARD, 3, INCHES, wait=True)\n   drivetrain.turn_for(LEFT, 40, DEGREES, wait=True)\n   drivetrain.drive(REVERSE)\n   while dis.object_distance(INCHES) > 14:\n       pass\n   drivetrain.stop()\n   intake.spin(FORWARD)\n   output.spin(REVERSE)\n   wait(2, SECONDS)\n   intake.spin(REVERSE)\n   output.spin(FORWARD)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   output.spin(REVERSE)\n   wait(2, SECONDS)\n   intake.spin(REVERSE)\n   output.spin(FORWARD)\n   wait(0.4, SECONDS)\n   intake.spin(FORWARD)\n   output.spin(REVERSE)\n   wait(2, SECONDS)\n   output.stop()\n   intake.stop()\n   drivetrain.drive_for(FORWARD, 50, INCHES, wait=True)\n   drivetrain.turn_for(LEFT, 40, DEGREES, wait=True)\n   drivetrain.drive(REVERSE)\n   while dis.object_distance(INCHES) > 6:\n       pass\n   drivetrain.stop()\n   output.spin(FORWARD)\n   intake.spin(FORWARD)\n   wait(3, SECONDS)\n   output.spin(REVERSE)\n   wait(0.3, SECONDS)\n   output.spin(FORWARD)\n   wait(3, SECONDS)\n   output.spin(REVERSE)\n   wait(0.3, SECONDS)\n   output.spin(FORWARD)\n   wait(3, SECONDS)\n   output.stop()\n   intake.stop()\n\ndef user_control():\n   print_thread = Thread(print_variable)\n   drivetrain.set_turn_velocity(25, PERCENT)\n   # place driver control in this while loop\n   while True:\n       wait(20, MSEC)\n\n\n# create competition instance\ncomp = Competition(user_control, autonomous)\npre_autonomous()","textLanguage":"python","robotConfig":[],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}